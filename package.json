{
  "name": "ozzy-tribute",
  "version": "3.1.0",
  "description": "Interaktives Fan-Tribute an Ozzy Osbourne",
  "main": "index.html",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "author": "Alexander Rothe",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "js/**/*.js"
    ],
    "coverageReporters": ["text", "lcov"],
    "coverageDirectory": "coverage"
  }
}